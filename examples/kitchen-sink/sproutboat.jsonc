{
  "$schema": "https://sproutboat.com/schema.json",
  "name": "kitchen-sink",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",

  // Every binding Sproutboat supports, in one app.
  "vars": {
    "SITE_NAME": "Sproutboat Notes",
    "QUOTE_URL": "https://api.quotable.local/random",
    // Kept in step with SB_REQUEST_BODY_MAX at run time; the runtime refuses a
    // larger body before the handler sees it.
    "MAX_UPLOAD_BYTES": "8388608",
  },
  "secrets": ["ADMIN_TOKEN"],
  "kv_namespaces": ["SESSIONS"],
  "d1_databases": ["DB"],
  "r2_buckets": ["UPLOADS"],
  "queues": ["EMAILS"],
  "analytics_engine_datasets": ["METRICS"],
  "durable_objects": { "VIEWS": "ViewCounter" },
  "outbound": ["api.quotable.local"],
  // #48 — worker-to-worker. The target must be a *different* deployment: one
  // sprout serves one turn at a time, so a binding pointing back at its own
  // project deadlocks until the request times out.
  "services": [{ "binding": "PEER", "service": "quote-service" }],
  "triggers": { "crons": ["*/1 * * * *"] },
  "assets": {
    // built by Astro — run `bun --cwd web run build` (harness.ts / serve.ts do this for you)
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_sprout_first": true,
  },
}
