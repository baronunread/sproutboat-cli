{
  "$schema": "https://sproutboat.com/schema.json",
  "name": "kitchen-sink",
  "main": "src/index.js",
  // The source awaits every binding, so it also runs on 2026-11-18, which service
  // bindings between Cloud apps need. The standalone harness stays on this date
  // until the async R2 binding has createUploadUrl and createDownloadUrl.
  "compatibility_date": "2026-11-18",

  // Every binding Sproutboat supports, in one app.
  "vars": {
    "SITE_NAME": "Sproutboat Notes",
    "QUOTE_URL": "https://api.quotable.local/random",
    // Deliberately small: an R2 object is held whole in memory, about 4x its
    // size standalone and 23x through a broker (#56). The runtime also refuses
    // an inbound body over SB_REQUEST_BODY_MAX, 1 MiB by default.
    "MAX_UPLOAD_BYTES": "65536",
  },
  "secrets": ["ADMIN_TOKEN"],
  "kv_namespaces": ["SESSIONS"],
  "d1_databases": ["DB"],
  "r2_buckets": ["UPLOADS"],
  "queues": ["EMAILS"],
  "analytics_engine_datasets": ["METRICS"],
  "durable_objects": { "VIEWS": "ViewCounter", "ROOM": "ChatRoom" },
  "ratelimiters": [{ "binding": "THROTTLE", "limit": 3, "period": 60 }],
  // #48 — worker-to-worker. The target must be a *different* deployment: one
  // sprout serves one turn at a time, so a binding pointing back at its own
  // project deadlocks until the request times out.
  "services": [{ "binding": "PEER", "service": "quote-service" }],
  "triggers": { "crons": ["*/1 * * * *"] },
  "assets": {
    // site/ is public/ plus build-info.json: run `bun run build` (the harnesses and serve.ts do it for you)
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_sprout_first": true,
  },
}
