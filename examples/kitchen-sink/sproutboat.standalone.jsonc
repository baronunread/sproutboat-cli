{
  // The same app for `sproutboat build --standalone -c sproutboat.standalone.jsonc`.
  // It is sproutboat.jsonc without the `services` entry: a standalone binary has
  // no edge to route a service binding through, and the build refuses one. The
  // dashboard sees `env.PEER` is missing and says so on that tile.
  "$schema": "https://sproutboat.com/schema.json",
  "name": "kitchen-sink",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "vars": {
    "SITE_NAME": "Sproutboat Notes",
    "MAX_UPLOAD_BYTES": "1048576",
    // The whole demo bucket: every file together, so a stranger cannot fill the disk.
    "MAX_TOTAL_BYTES": "8388608",
    // A file is deleted an hour after its upload.
    "FILE_TTL_SECONDS": "3600",
  },
  "secrets": ["ADMIN_TOKEN"],
  "kv_namespaces": ["SESSIONS"],
  "d1_databases": ["DB"],
  "r2_buckets": ["UPLOADS"],
  "queues": ["EMAILS"],
  "analytics_engine_datasets": ["METRICS"],
  "durable_objects": { "ROOM": "ChatRoom" },
  // Every one is a budget per client address (see src/index.js, gate()).
  "ratelimiters": [
    // the secret check and failed admin tokens
    { "binding": "THROTTLE", "limit": 3, "period": 60 },
    // every route that writes, plus outbound calls
    { "binding": "WRITES", "limit": 30, "period": 60 },
    // upload chunks (they do not count against WRITES; the hour's bytes are limited too)
    { "binding": "BULK", "limit": 60, "period": 60 },
    // the dashboard GET routes
    { "binding": "READS", "limit": 240, "period": 60 },
  ],
  // */1 records a run in the events feed; */15 deletes the files whose hour is up (and chunks of
  // abandoned uploads); 0 4 * * * resets the demo data (UTC)
  "triggers": { "crons": ["*/1 * * * *", "*/15 * * * *", "0 4 * * *"] },
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_sprout_first": true,
  },
}
