{
  "$schema": "https://sproutboat.com/schema.json",
  "name": "assets",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Serve the handler first, so /api wins and everything else falls through
    // to a file. Without this, a file shadowing a route wins instead.
    "run_sprout_first": ["/api/*"],
  },
}
