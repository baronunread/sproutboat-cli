{
  "$schema": "https://sproutboat.com/schema.json",
  "name": "kitchen-sink",
  "main": "src/index.js",
  // The source awaits every binding, so it also runs on 2026-11-18, which service
  // bindings between Cloud apps need. The standalone harness stays on this date
  // until the async R2 binding has createUploadUrl and createDownloadUrl.
  "compatibility_date": "2026-11-18",

  // Every binding Sproutboat supports, in one app.
  "vars": {
    "SITE_NAME": "Sproutboat Notes",
    // A file is stored as 1 MiB R2 objects, one per upload request and one per download read, so no
    // request holds a whole file and the worker stays flat (sproutd gives an app 32 MiB, and its R2
    // get() reads a whole object into memory). Per file 25 MiB, all files 200 MiB, and per client
    // address 100 MiB uploaded a day (and an hour) and 250 MiB downloaded an hour. A file is deleted
    // an hour after its upload, so the demo is no file hosting.
    "MAX_UPLOAD_BYTES": "26214400",
    "MAX_TOTAL_BYTES": "209715200",
    // One response sends at most this much of a file; the rest is read with Range requests. Each chunk a
    // response reads costs about seven times its size in worker memory until the response ends.
    "MAX_RESPONSE_BYTES": "2097152",
    "MAX_UPLOAD_PER_HOUR": "104857600",
    // 04:00 UTC to 04:00 UTC, the same day as the daily reset
    "MAX_UPLOAD_PER_DAY": "104857600",
    "FILE_TTL_SECONDS": "3600",
    "MAX_DOWNLOAD_PER_HOUR": "262144000",
  },
  "secrets": ["ADMIN_TOKEN"],
  "kv_namespaces": ["SESSIONS"],
  "d1_databases": ["DB"],
  "r2_buckets": ["UPLOADS"],
  "queues": ["EMAILS"],
  "analytics_engine_datasets": ["METRICS"],
  "durable_objects": { "ROOM": "ChatRoom" },
  // Every one is a budget per client address (see src/index.js, gate()).
  "ratelimiters": [
    // the secret check and failed admin tokens
    { "binding": "THROTTLE", "limit": 3, "period": 60 },
    // every route that writes, plus outbound calls
    { "binding": "WRITES", "limit": 30, "period": 60 },
    // upload chunks (they do not count against WRITES; the hour's bytes are limited too)
    { "binding": "BULK", "limit": 60, "period": 60 },
    // the dashboard GET routes
    { "binding": "READS", "limit": 240, "period": 60 },
  ],
  // #48 — worker-to-worker. The target must be a *different* deployment: one
  // sprout serves one turn at a time, so a binding pointing back at its own
  // project deadlocks until the request times out.
  "services": [{ "binding": "PEER", "service": "quote-service" }],
  // */1 records a run in the events feed; */15 deletes the files whose hour is up (and chunks of
  // abandoned uploads); 0 4 * * * resets the demo data (UTC)
  "triggers": { "crons": ["*/1 * * * *", "*/15 * * * *", "0 4 * * *"] },
  "assets": {
    // site/ is public/ plus build-info.json: run `bun run build` (the harnesses and serve.ts do it for you)
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_sprout_first": true,
  },
}
