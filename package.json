{
  "name": "sproutboat",
  "version": "0.9.0",
  "description": "Wrangler-shaped CLI for Sproutboat. Deploys workers to any control plane via --api-url / SPROUTBOAT_API_URL.",
  "keywords": [
    "cli",
    "deploy",
    "edge",
    "porffor",
    "serverless",
    "sproutboat",
    "wrangler"
  ],
  "homepage": "https://github.com/baronunread/sproutboat-cli",
  "bugs": "https://github.com/baronunread/sproutboat-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baronunread/sproutboat-cli.git"
  },
  "bin": {
    "sproutboat": "bin/sproutboat.cjs"
  },
  "files": [
    "CHANGELOG.md",
    "SURFACE.md",
    "src",
    "bin/sproutboat.cjs",
    "scripts",
    "types",
    "vendor"
  ],
  "type": "module",
  "types": "./types/sproutboat.d.ts",
  "exports": {
    "./runtime/config": "./src/config.ts",
    "./runtime/source": "./src/source.ts",
    "./runtime/manifest": "./src/manifest.ts",
    "./runtime/assets": "./src/assets.ts",
    "./runtime/broker": "./src/broker.ts",
    "./runtime/wrap": "./src/wrap.ts",
    "./package.json": "./package.json",
    "./types": "./types/sproutboat.d.ts"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "examples": "bun examples/smoke.ts",
    "build:cli": "bun scripts/build-cli.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test",
    "example:kitchen-sink": "bun examples/kitchen-sink/harness.ts",
    "surface": "UPDATE_SURFACE=1 bun test src/surface.test.ts",
    "version": "bun run surface && git add SURFACE.md",
    "prepublishOnly": "bun run typecheck && bun test",
    "style": "bunx style-doctor@latest --quiet",
    "kitchen-sink": "bun examples/kitchen-sink/harness.ts",
    "kitchen-sink:standalone": "bun examples/kitchen-sink/harness-standalone.ts"
  },
  "dependencies": {
    "@sproutboat/artifact": "^0.2.0",
    "@sproutboat/assets": "^0.2.0",
    "@sproutboat/config": "^0.2.0",
    "@sproutboat/runtime": "^0.2.0",
    "@sproutboat/wire": "^0.2.0",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "1.4.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@sproutboat/cli-darwin-arm64": "0.9.0",
    "@sproutboat/cli-darwin-x64": "0.9.0",
    "@sproutboat/cli-linux-arm64": "0.9.0",
    "@sproutboat/cli-linux-x64": "0.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
