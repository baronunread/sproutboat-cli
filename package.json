{
  "name": "@sproutboat/cli",
  "version": "0.1.0",
  "description": "Wrangler-shaped CLI for Sproutboat — works against any control plane (self-hosted or cloud) via --api-url / SPROUTBOAT_API_URL.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sproutboat": "src/main.ts"
  },
  "files": [
    "src",
    "patches"
  ],
  "scripts": {
    "postinstall": "bun run src/patch-porffor.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "porffor": "github:CanadaHonk/porffor#alpha-4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.2"
  }
}
